# Board clock and 50 MHz timing.
NET "clk" LOC = "C9" | IOSTANDARD = LVCMOS33;
NET "clk" TNM_NET = "clk_group";
TIMESPEC "TS_clk" = PERIOD "clk_group" 20 ns HIGH 50%;
# VGA sync and DAC clock pins.
NET "H" LOC = "C5" | IOSTANDARD = LVCMOS33;
NET "V" LOC = "D5" | IOSTANDARD = LVCMOS33;
NET "DAC_CLK" LOC = "A4" | IOSTANDARD = LVCMOS33;
# Blue output pins.
NET "Bout<7>" LOC = "B16" | IOSTANDARD = LVCMOS33;
NET "Bout<6>" LOC = "A16" | IOSTANDARD = LVCMOS33;
NET "Bout<5>" LOC = "D14" | IOSTANDARD = LVCMOS33;
NET "Bout<4>" LOC = "C14" | IOSTANDARD = LVCMOS33;
NET "Bout<3>" LOC = "B14" | IOSTANDARD = LVCMOS33;
NET "Bout<2>" LOC = "A14" | IOSTANDARD = LVCMOS33;
NET "Bout<1>" LOC = "B13" | IOSTANDARD = LVCMOS33;
NET "Bout<0>" LOC = "A13" | IOSTANDARD = LVCMOS33;
# Green output pins.
NET "Gout<0>" LOC = "F9" | IOSTANDARD = LVCMOS33;
NET "Gout<1>" LOC = "E9" | IOSTANDARD = LVCMOS33;
NET "Gout<2>" LOC = "D11" | IOSTANDARD = LVCMOS33;
NET "Gout<3>" LOC = "C11" | IOSTANDARD = LVCMOS33;
NET "Gout<4>" LOC = "F11" | IOSTANDARD = LVCMOS33;
NET "Gout<5>" LOC = "E11" | IOSTANDARD = LVCMOS33;
NET "Gout<6>" LOC = "E12" | IOSTANDARD = LVCMOS33;
NET "Gout<7>" LOC = "F12" | IOSTANDARD = LVCMOS33;
# Red output pins.
NET "Rout<0>" LOC = "A6" | IOSTANDARD = LVCMOS33;
NET "Rout<1>" LOC = "B6" | IOSTANDARD = LVCMOS33;
NET "Rout<2>" LOC = "E7" | IOSTANDARD = LVCMOS33;
NET "Rout<3>" LOC = "F7" | IOSTANDARD = LVCMOS33;
NET "Rout<4>" LOC = "D7" | IOSTANDARD = LVCMOS33;
NET "Rout<5>" LOC = "C7" | IOSTANDARD = LVCMOS33;
NET "Rout<6>" LOC = "F8" | IOSTANDARD = LVCMOS33;
NET "Rout<7>" LOC = "E8" | IOSTANDARD = LVCMOS33;
# Paddle switch pins.
NET "SW0" LOC = "N17" | IOSTANDARD = LVCMOS33;
NET "SW1" LOC = "H18" | IOSTANDARD = LVCMOS33;
NET "SW2" LOC = "L14" | IOSTANDARD = LVCMOS33;
NET "SW3" LOC = "L13" | IOSTANDARD = LVCMOS33;
